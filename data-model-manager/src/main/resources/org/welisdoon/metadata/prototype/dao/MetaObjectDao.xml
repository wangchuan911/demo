<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.welisdoon.metadata.prototype.dao.MetaObjectDao">

    <resultMap id="MetaObject" type="org.welisdoon.metadata.prototype.define.MetaObject">
        <id column="id" property="id"></id>
        <result column="type_id" property="typeId"></result>
        <result column="name" property="name"></result>
        <result column="code" property="code"></result>
    </resultMap>
    <select id="list"
            parameterType="org.welisdoon.metadata.prototype.condition.MetaObjectCondition"
            resultMap="MetaObject">
        select * from MD_OBJECT
        <where>
            <if test="parentId!=null ">and parent_id = #{parentId}</if>
            <choose>
                <when test="query=='objectSearch' and @org.apache.commons.lang.StringUtils@isNotEmpty(data.code)">
                    and code like concat('%',#{data.code},'%')
                </when>
            </choose>
        </where>

    </select>


    <select id="get"
            parameterType="long"
            resultMap="MetaObject">
        select * from MD_OBJECT
        <where>
            and id=#{value}
        </where>

    </select>
    <insert id="add" parameterType="org.welisdoon.metadata.prototype.define.MetaObject" useGeneratedKeys="true" keyProperty="id">
        insert into MD_OBJECT(id,type_id,name,code) values(#{id},#{typeId},#{name},#{code})
    </insert>
    <update id="put" parameterType="org.welisdoon.metadata.prototype.define.MetaObject">
        update MD_OBJECT
        <set>
            <if test="parentId!=null">
                parent_id=#{parentId},
            </if>
        </set>
        where id=#{id}
    </update>
    <delete id="delete" parameterType="long">
        delete from MD_OBJECT where id=#{value}
    </delete>
</mapper>
