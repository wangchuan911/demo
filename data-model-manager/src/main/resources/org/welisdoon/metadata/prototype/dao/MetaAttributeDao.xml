<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.welisdoon.metadata.prototype.dao.MetaAttributeDao">

    <resultMap id="MetaAttribute" type="org.welisdoon.metadata.prototype.define.MetaObject$Attribute">
        <id column="id" property="id"></id>
        <result column="type_id" property="typeId"></result>
        <result column="name" property="name"></result>
        <result column="code" property="code"></result>
        <result column="object_id" property="objectId"></result>
        <discriminator column="type_id" javaType="long" typeHandler="org.welisdoon.metadata.prototype.dao.MetaTypeHandler">
            <case value="Field" resultType="org.welisdoon.metadata.prototype.entity.DataObject$Field"></case>
            <case value="Column" resultType="org.welisdoon.metadata.prototype.entity.DataBaseTable$Column"></case>
            <case value="UNKNOWN" resultType="org.welisdoon.metadata.prototype.define.MetaObject$Attribute"></case>
        </discriminator>
    </resultMap>
    <select id="list"
            parameterType="org.welisdoon.metadata.prototype.condition.MetaAttributeCondition"
            resultMap="MetaAttribute">
        select * from MD_OBJECT_ATTR
        <where>
            <if test="parentId!=null ">and parent_id = #{parentId}</if>
            <if test="objectId!=null ">and object_id = #{objectId}</if>
        </where>

    </select>
    <select id="get"
            parameterType="long"
            resultMap="MetaAttribute">
        select * from MD_OBJECT_ATTR
        <where>
            and id=#{value}
        </where>

    </select>

    <insert id="add" parameterType="org.welisdoon.metadata.prototype.define.MetaObject$Attribute"
            useGeneratedKeys="true" keyProperty="id">
        insert into MD_OBJECT_ATTR(id, type_id, code, name, object_id,parent_id)
        values (#{id}, #{typeId}, #{code}, #{name}, #{objectId},#{parentId,jdbcType=NUMERIC})
    </insert>

    <delete id="delete" parameterType="long">
        delete
        from MD_OBJECT_ATTR
        where id = #{value}
    </delete>

    <select id="generate" parameterType="long" resultMap="MetaAttribute">
        select #{value} type_id from dual
    </select>
    <insert id="put" parameterType="org.welisdoon.metadata.prototype.define.MetaObject$Attribute" >
        update MD_OBJECT_ATTR set type_id= #{typeId}, code=#{code}, name=#{name}, object_id=#{objectId}, parent_id=#{parentId,jdbcType=NUMERIC}
        where id=#{id}
    </insert>
    <update id="update" parameterType="org.welisdoon.metadata.prototype.define.MetaObject$Attribute">
        update MD_OBJECT_ATTR
        <set>
            <if test="@org.apache.commons.lang.StringUtils@isNotEmpty(code)">
                code=#{code},
            </if>
            <if test="@org.apache.commons.lang.StringUtils@isNotEmpty(name)">
                name=#{name},
            </if>
        </set>
            where id=#{id}
    </update>
</mapper>

